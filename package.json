{
  "name": "autonomous-social-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run server:dev\" \"vite --host 127.0.0.1\"",
    "dev:bot": "concurrently -n api,web,bot,scheduler -c cyan,green,magenta,yellow \"npm run server:dev\" \"vite --host 127.0.0.1\" \"npm run telegram:poll\" \"npm run scheduler\"",
    "dev:web": "vite --host 127.0.0.1",
    "server:dev": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "worker": "tsx scripts/worker.ts",
    "scheduler": "tsx scripts/scheduler.ts",
    "telegram:poll": "tsx scripts/telegram-poll.ts",
    "dev:all": "npm run dev:bot",
    "setup": "tsx scripts/setup.ts",
    "reset:data": "tsx scripts/reset-data.ts",
    "doctor": "tsx scripts/doctor.ts",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "npm run build && npm run server"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.23.11",
    "vitest": "^4.1.10"
  }
}
